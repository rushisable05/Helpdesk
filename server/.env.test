# ==========================================
# Test Environment Configuration
# ==========================================

# Dedicated Test Database (Isolated from Dev DB on port 5432)
# Runs embedded PGlite test server on port 5433 with .pgdata-test
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/helpdesk_test?schema=public"

# Auth Secrets & Test Server Endpoints
BETTER_AUTH_SECRET="test-secret-do-not-use-in-production"
BETTER_AUTH_URL="http://localhost:3001"

# Allowed Test Client Origin (Vite test port 5174)
TRUSTED_ORIGINS="http://localhost:5174"

# Backend Test API Port
PORT=3001

# Webhook Secret for Test Endpoints
WEBHOOK_SECRET="test-webhook-secret"

# Default Seeded Admin Credentials for E2E Tests
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="password123"
